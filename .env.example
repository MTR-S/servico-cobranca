# ==============================================================================
# Configuração do Sistema de Fechamento Semanal e Repasse (Getnet + WhatsApp)
# ==============================================================================

# ------------------------------------------------------------------------------
# Ambiente Geral
# ------------------------------------------------------------------------------
NODE_ENV=development
TIMEZONE=America/Sao_Paulo

# ------------------------------------------------------------------------------
# Credenciais e Parâmetros da Getnet (Portal Minha Conta)
# ------------------------------------------------------------------------------
# Login e senha para autenticação no portal Minha Conta Getnet
GETNET_USERNAME=usuario_getnet
GETNET_PASSWORD=senha_segura_getnet

# Ativa o modo de simulação/fixture para testes locais e desenvolvimento sem acesso real
GETNET_MOCK_MODE=false

# ------------------------------------------------------------------------------
# Regras de Negócio e Terminais Alocados
# ------------------------------------------------------------------------------
# Lista de números de série / identificadores de terminal (POS) separados por vírgula
TERMINAL_NUMBERS=12345678,87654321

# Percentual de comissão retida pelo Titular (ex: 5.0 para 5%)
COMMISSION_PERCENTAGE=5.0

# ------------------------------------------------------------------------------
# Conexão e Controle de Mensageria WhatsApp (Baileys)
# ------------------------------------------------------------------------------
# Identificador único (JID) do grupo oficial de WhatsApp
WHATSAPP_GROUP_ID=120363021234567890@g.us

# Lista de remetentes (números de telefone / JIDs) autorizados a solicitar fechamento no grupo
WHATSAPP_ALLOWED_SENDERS=5511999999999,5511888888888

# Lista de números de administradores para comandos forçados e alertas técnicos
WHATSAPP_ADMIN_SENDERS=5511999999999

# Modo de autenticação inicial: QR_CODE (exibe no terminal) ou PAIRING_CODE (código de 8 dígitos)
WHATSAPP_AUTH_MODE=QR_CODE

# Número para recebimento do Pairing Code de 8 dígitos (necessário se WHATSAPP_AUTH_MODE=PAIRING_CODE)
# WHATSAPP_PAIRING_PHONE_NUMBER=5511999999999

# Caminho para armazenamento persistente da sessão do WhatsApp
WHATSAPP_SESSION_PATH=./data/whatsapp-session

# ------------------------------------------------------------------------------
# Broker de Mensageria (RabbitMQ)
# ------------------------------------------------------------------------------
# URL de conexão AMQP com o RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ------------------------------------------------------------------------------
# Caminhos de Persistência e Volumes Locais
# ------------------------------------------------------------------------------
# Caminho para o banco de dados SQLite de auditoria e histórico
SQLITE_DB_PATH=./data/sqlite.db

# Perfil persistente do navegador Chromium (Playwright)
PLAYWRIGHT_USER_DATA_DIR=./data/browser-profile

# Diretório para armazenamento e processamento de planilhas de fallback (CSV / XLSX)
IMPORTS_DIR=./data/imports

# Diretório para gravação de screenshots de diagnóstico em falhas de scraping
SCREENSHOTS_DIR=./data/screenshots
